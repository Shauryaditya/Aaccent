---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";

// Filter out drafts
const publishedServices = await getCollection("services", ({ data }) => {
  return data.draft !== true;
});

// Sort services: High School first, Senior Secondary second, Entrance Corner third
const serviceOrder: Record<string, number> = {
  "Secondary & High School": 1,
  "Senior Secondary Boards": 2,
  "Entrance Corner": 3
};

const sortedServices = publishedServices.sort((a, b) => {
  const orderA = serviceOrder[a.data.name] || 99;
  const orderB = serviceOrder[b.data.name] || 99;
  return orderA - orderB;
});

// Academic Pillars details
const pillars = [
  {
    title: "Conceptual Foundations First",
    description: "We focus heavily on core concepts, physical derivations, and logical proofs rather than rote memorization, building a permanent base of understanding.",
    icon: "lightbulb"
  },
  {
    title: "Rigorous Test Series",
    description: "Weekly chapter tests and monthly mock examinations replicating board (ICSE, CBSE, W.B.) and entrance environments with thorough grading feedback.",
    icon: "chart"
  },
  {
    title: "Computer Science Labs",
    description: "Practical programming sessions on Java (BlueJ), C++, and VB, with specialized project file assistance and practical exam readiness reviews.",
    icon: "code"
  },
  {
    title: "Structured Parent Feedback",
    description: "Frequent performance analytics, attendance monitoring, and direct query redressal calls to keep parents informed of their child's milestone growth.",
    icon: "users"
  }
];

// Journey Steps details
const steps = [
  {
    num: "01",
    title: "Diagnostic Screening",
    description: "We gauge the student's baseline understanding, learning speed, and concept gaps."
  },
  {
    num: "02",
    title: "Conceptual Lectures",
    description: "Interactive lectures covering fundamental theories, diagrams, and mathematical derivations."
  },
  {
    num: "03",
    title: "Worksheets & Practice",
    description: "Solving curated assignments, past year board papers, and competitive test banks."
  },
  {
    num: "04",
    title: "Mock Assessments",
    description: "Simulated exam conditions under strict timelines to build exam confidence and time management."
  },
  {
    num: "05",
    title: "Error Resolution",
    description: "One-on-one reviews to correct mistakes, clarify doubts, and optimize exam strategies."
  }
];
---

<Layout title="Our Academic Programs | Advantage Academic Center">
  <!-- Page Hero Header -->
  <div class="relative overflow-hidden py-16 sm:py-24 bg-gradient-to-b from-tan-light/10 via-[#FAF5EE] to-[#FAF5EE]">
    <Container class="relative z-10 text-center">
      <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-semibold bg-tan/20 border border-tan/30 text-oxford">
        Our Offerings
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-oxford mt-4 tracking-tight leading-tight">
        Academic Programs & Services
      </h1>
      <p class="text-lg sm:text-xl text-slate-700 max-w-2xl mx-auto mt-6 leading-relaxed">
        Empowering students from Class IV through XII and competitive engineering exams with structured guidance, proven methodologies, and personalized attention.
      </p>
    </Container>
  </div>

  <Container>
    <!-- Core Courses Grid -->
    <div class="mt-8 mb-16">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-oxford">Featured Coaching Services</h2>
        <p class="text-slate-600 mt-2">Explore our tailored curriculums designed for board excellence and college admission.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          sortedServices.map((fees) => (
            <div class="group bg-white rounded-2xl border border-tan/30 shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex flex-col justify-between overflow-hidden">
              <div class="p-6 sm:p-8 flex-1">
                <!-- Header Badge & Icon -->
                <div class="flex items-center justify-between mb-6">
                  <span class="text-xs font-semibold px-2.5 py-1 bg-tan/15 text-oxford rounded-full border border-tan/20">
                    {fees.data.badge || "Coaching Program"}
                  </span>
                  
                  <div class="p-3 bg-tan/10 rounded-xl text-oxford">
                    {fees.data.icon === "book" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                      </svg>
                    )}
                    {fees.data.icon === "atom" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                      </svg>
                    )}
                    {fees.data.icon === "trophy" && (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7.463 1.247A2 2 0 003 11v3a2 2 0 002 2h3m-.037-5A2 2 0 0110 8h2v8H10a2 2 0 01-2-2v-3zm11.037-1.253A2 2 0 0121 11v3a2 2 0 01-2 2h-3m.037-5A2 2 0 0014 8h-2v8h2a2 2 0 002-2v-3z" />
                      </svg>
                    )}
                  </div>
                </div>

                <!-- Course Title & Targets -->
                <h3 class="text-2xl font-bold text-oxford mb-2 group-hover:text-oxford-light transition duration-300">
                  {fees.data.name}
                </h3>
                <p class="text-sm font-semibold text-slate-500 mb-4">
                  {fees.data.classes}
                </p>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">
                  {fees.data.description || "Comprehensive coaching and practice designed to build clarity, performance, and board success."}
                </p>

                <!-- Subjects Cover -->
                <div class="mb-6">
                  <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Subjects Offered</h4>
                  <p class="text-sm font-semibold text-oxford-dark bg-tan/5 p-3 rounded-lg border border-tan/10">
                    {fees.data.features.subjects}
                  </p>
                </div>

                <!-- Key Features Bullet List -->
                {fees.data.featuresList && fees.data.featuresList.length > 0 && (
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Program Highlights</h4>
                    <ul class="space-y-2.5">
                      {fees.data.featuresList.map((feature: string) => (
                        <li class="flex items-start text-xs text-slate-600 leading-normal">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-tan-dark mr-2 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                          </svg>
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>

              <!-- Button CTA -->
              <div class="px-6 pb-8 pt-0">
                <a
                  href="/#enrollment"
                  class="block w-full text-center py-3 px-4 rounded-xl border border-oxford text-oxford hover:bg-oxford hover:text-white font-semibold text-sm transition-all duration-300 shadow-sm hover:shadow"
                >
                  Inquire for Admissions
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Section: Specialized Math Coaching Focus (High Search Intent Capture) -->
    <div class="my-24 bg-white rounded-3xl border border-tan/30 shadow-md p-8 sm:p-12">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-semibold bg-tan/20 border border-tan/30 text-oxford">
            Featured Specialization
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-oxford mt-4 tracking-tight">
            Specialized Mathematics Tutoring
          </h2>
          <p class="text-slate-600 mt-6 leading-relaxed text-sm sm:text-base">
            Advantage Academic Center is widely recognized as a premier destination for expert mathematics coaching. Led by Subrata Bardhan (B.E. Mechanical), our tutoring program is designed to transform complex equations, calculus, and geometry proofs into logical, approachable steps for students at all academic levels.
          </p>
          
          <div class="mt-8 space-y-4">
            <div class="flex items-start">
              <div class="p-2 bg-tan/10 rounded-lg text-oxford mr-4 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-oxford text-sm sm:text-base">Foundational Arithmetic & Algebra (Classes IV - VIII)</h4>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Establishing calculation speed, fraction operations, mental math patterns, and basic algebraic foundations.</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="p-2 bg-tan/10 rounded-lg text-oxford mr-4 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-oxford text-sm sm:text-base">Geometry Proofs & Board Excellence (Classes IX - X)</h4>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Comprehensive board exam syllabus coverage (ICSE, CBSE, State Boards) focusing on theorem derivations and rigorous stepwise formatting.</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="p-2 bg-tan/10 rounded-lg text-oxford mr-4 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
              </div>
              <div>
                <h4 class="font-bold text-oxford text-sm sm:text-base">Advanced Calculus, Algebra & Vectors (Classes XI - XII)</h4>
                <p class="text-xs sm:text-sm text-slate-500 mt-1">Detailed, conceptual exploration of derivatives, integrations, matrix algebra, probability, and 3D coordinate geometry.</p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="bg-[#FAF5EE] rounded-2xl border border-tan/30 p-6 sm:p-8 flex flex-col justify-between h-full">
          <div>
            <h3 class="text-xl font-bold text-oxford mb-4 font-outfit">Why Our Mathematics Program Succeeds</h3>
            <ul class="space-y-4">
              <li class="flex items-start text-xs sm:text-sm text-slate-700">
                <svg class="w-5 h-5 text-tan-dark mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                <span><strong>Curated Math Problem Banks:</strong> Over 10,000+ chapter-wise questions from basics to engineering board and JEE formats.</span>
              </li>
              <li class="flex items-start text-xs sm:text-sm text-slate-700">
                <svg class="w-5 h-5 text-tan-dark mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                <span><strong>Multi-Textbook Mastery:</strong> Extensive coverage of standard references including NCERT, RS Aggarwal, and ML Aggarwal.</span>
              </li>
              <li class="flex items-start text-xs sm:text-sm text-slate-700">
                <svg class="w-5 h-5 text-tan-dark mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                <span><strong>Step-Wise Marks Optimization:</strong> We train students to present their solutions neatly, maximizing partial marking layouts in boards.</span>
              </li>
              <li class="flex items-start text-xs sm:text-sm text-slate-700">
                <svg class="w-5 h-5 text-tan-dark mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                <span><strong>Doubt-Clearing Clinics:</strong> Direct, one-on-one reviews with tutors to address individual homework and exam errors.</span>
              </li>
            </ul>
          </div>
          
          <div class="mt-8 border-t border-tan/30 pt-6 flex items-center justify-between gap-4">
            <div>
              <p class="text-xs text-slate-500">Struggling with math prep?</p>
              <p class="text-sm font-bold text-oxford mt-0.5">Request a Free Demo Class</p>
            </div>
            <a href="/#enrollment" class="bg-oxford hover:bg-oxford-light text-white text-xs font-semibold px-5 py-3 rounded-lg transition duration-300 whitespace-nowrap">
              Register Today
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Divider Line -->
    <hr class="border-tan/30 my-20" />

    <!-- Section: Academic Pillars -->
    <div class="my-24">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-tan-dark">Our Methodology</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-oxford mt-2">
          The Pillars of Advantage Pedagogy
        </h2>
        <p class="text-slate-600 mt-4 leading-relaxed">
          For over 18 years, our students have excelled in boards and entrance exams. Here is the operational philosophy behind our institutional success.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          pillars.map((pillar) => (
            <div class="bg-white p-6 sm:p-8 rounded-2xl border border-tan/25 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col items-start">
              <div class="p-3 bg-tan/10 rounded-xl text-oxford mb-6">
                {pillar.icon === "lightbulb" && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                  </svg>
                )}
                {pillar.icon === "chart" && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                )}
                {pillar.icon === "code" && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                )}
                {pillar.icon === "users" && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                  </svg>
                )}
              </div>
              <h3 class="text-lg font-bold text-oxford mb-2">{pillar.title}</h3>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{pillar.description}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Divider Line -->
    <hr class="border-tan/30 my-20" />

    <!-- Section: Student Journey Timeline -->
    <div class="my-24">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-tan-dark">The Student Experience</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-oxford mt-2">
          Your Success Journey Roadmap
        </h2>
        <p class="text-slate-600 mt-4 leading-relaxed">
          How we guide students step-by-step from enrollment diagnostic evaluation to high score achievements.
        </p>
      </div>

      <div class="relative">
        <!-- Connecting Line for Desktop -->
        <div class="hidden lg:block absolute top-10 left-[10%] right-[10%] h-0.5 bg-tan/30 z-0"></div>

        <div class="grid lg:grid-cols-5 gap-8 relative z-10">
          {
            steps.map((step) => (
              <div class="flex flex-col items-center lg:items-start text-center lg:text-left group">
                <!-- Step Number Bubble -->
                <div class="w-20 h-20 rounded-2xl bg-white border border-tan/35 shadow-md flex items-center justify-center mb-6 group-hover:border-oxford-light transition duration-300 bg-gradient-to-br from-white to-tan-light/10">
                  <span class="text-3xl font-extrabold text-oxford leading-none font-outfit">
                    {step.num}
                  </span>
                </div>
                <!-- Title & Description -->
                <h3 class="text-lg font-bold text-oxford mb-2 group-hover:text-oxford-light transition duration-300">
                  {step.title}
                </h3>
                <p class="text-slate-600 text-xs sm:text-sm leading-relaxed max-w-xs">
                  {step.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Section: CTA Banner -->
    <div class="relative overflow-hidden bg-gradient-to-br from-oxford-dark via-oxford to-oxford-light text-white rounded-3xl p-10 md:p-16 shadow-2xl mt-16 mb-24 border border-oxford-light/50">
      <!-- Background Abstract Shapes -->
      <div class="absolute inset-0 opacity-15">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <circle cx="20" cy="20" r="30" fill="white" class="animate-pulse"></circle>
          <circle cx="85" cy="75" r="25" fill="white" class="animate-pulse"></circle>
        </svg>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-10">
        <div class="text-center lg:text-left max-w-xl">
          <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-semibold bg-white/10 text-tan border border-white/15 mb-4">
            Trial Session Available
          </span>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight">
            Elevate Your Academic Performance
          </h2>
          <p class="text-white/80 mt-4 text-base sm:text-lg leading-relaxed">
            Ready to secure top grades in school and competitive boards? Enroll today or request a consultation session with our expert faculty.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto shrink-0 justify-center">
          <a
            href="/#enrollment"
            class="bg-tan hover:bg-tan-dark text-oxford-dark font-bold text-center px-8 py-4 rounded-xl transition duration-300 shadow-md hover:shadow-lg text-base w-full sm:w-auto"
          >
            Apply / Enroll Now
          </a>
          <a
            href="tel:+919433427259"
            class="border border-white/30 hover:border-white text-white font-semibold text-center px-8 py-4 rounded-xl transition duration-300 text-base w-full sm:w-auto hover:bg-white/5"
          >
            Call Admissions
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>
