---
import Layout from "../layouts/Layout.astro";
import ResultsShowcase from "../components/ResultsShowcase.jsx";
---

<Layout title="Board Results & Toppers | Advantage Academic Center">
  <!-- Google Fonts Connection -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <div class="relative bg-gradient-to-br from-[#FAF5EE] via-[#F4ECE0] to-[#FAF5EE] overflow-hidden py-16 px-4 md:px-8 lg:px-16 min-h-[90vh]">
    
    <!-- Background glow decoration -->
    <div class="absolute inset-0 z-0 opacity-40 pointer-events-none">
      <div class="absolute top-[10%] left-[10%] w-[50%] h-[40%] bg-tan/30 rounded-full blur-[140px]"></div>
      <div class="absolute bottom-[10%] right-[10%] w-[50%] h-[40%] bg-oxford/10 rounded-full blur-[140px]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(0,33,71,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,33,71,0.03)_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto w-full text-center mb-16">
      
      {/* Title */}
      <div class="inline-flex items-center gap-2 bg-tan/20 text-tan-dark border border-tan/30 px-4 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-widest mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-tan-dark animate-pulse"></span>
        Hall of Fame
      </div>
      
      <h1 class="text-4xl md:text-6xl font-black text-oxford-dark tracking-tight leading-none mb-6 font-outfit">
        Board Exam <br class="sm:hidden" />
        <span class="text-tan-dark relative inline-block">
          Toppers & Results
          <span class="absolute bottom-1 left-0 w-full h-[4px] bg-tan/50 rounded"></span>
        </span>
      </h1>
      
      <p class="text-base md:text-lg text-oxford/85 leading-relaxed max-w-2xl mx-auto font-inter">
        Our students have consistently set milestones of academic excellence through rigorous preparation, 
        conceptual depth, and professional guidance. Explore their scores below.
      </p>
    </div>

    {/* Showcase component */}
    <div class="relative z-10 font-inter">
      <ResultsShowcase client:load />
    </div>

  </div>
</Layout>

<style is:global>
  /* Premium Font styling */
  .font-outfit {
    font-family: 'Outfit', 'Inter', sans-serif;
  }
  .font-inter {
    font-family: 'Inter', sans-serif;
  }
</style>
