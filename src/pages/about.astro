---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";

// Filter team entries with 'draft: false'
const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return data.draft !== true;
});

// Values details
const values = [
  {
    title: "Conceptual Foundations First",
    description: "We focus on physical derivations, logical proofs, and base-level math rather than simple rote learning, building structural intelligence.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>`
  },
  {
    title: "Practical Programming Labs",
    description: "Integrating Java (BlueJ), C++, and Visual Basic coding concepts directly with board assignments to give students analytical engineering-level readiness.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>`
  },
  {
    title: "Transparent Feedback Loops",
    description: "Frequent performance metrics, chapter testing grading lists, attendance monitoring, and direct communication to parent representatives.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>`
  }
];
---

<Layout title="About Us | Advantage Academic Center">
  <!-- Page Hero Header -->
  <div class="relative overflow-hidden py-16 sm:py-24 bg-gradient-to-b from-tan-light/10 via-[#FAF5EE] to-[#FAF5EE]">
    <Container class="relative z-10 text-center">
      <span class="inline-flex items-center gap-1.5 py-1 px-3.5 rounded-full text-xs font-semibold bg-tan/20 border border-tan/30 text-oxford">
        Our Legacy
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-oxford mt-4 tracking-tight leading-tight">
        The Advantage Story & Mission
      </h1>
      <p class="text-lg sm:text-xl text-slate-700 max-w-2xl mx-auto mt-6 leading-relaxed">
        Building conceptual foundations and coaching excellence in science and mathematics since 2005.
      </p>
    </Container>
  </div>

  <Container>
    <!-- Narrative Section: Our History -->
    <div class="my-16 md:my-24">
      <div class="grid md:grid-cols-2 gap-12 items-start max-w-5xl mx-auto">
        <!-- Left Column: History & Founder -->
        <div class="space-y-6">
          <span class="text-xs font-bold uppercase tracking-widest text-tan-dark">Our Origins</span>
          <h2 class="text-3xl font-bold text-oxford">Over 18 Years of Dedication</h2>
          
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Advantage Academic Center started its journey in December 2005 from scratch. The institute was founded by <strong>Subrata Bardhan (B.E. Mechanical)</strong> along with his wife, who by then had already been a competent Physics teacher for six years.
          </p>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            After completing his engineering at NIT Allahabad, Subrata Bardhan spent 14 years working in senior roles at prominent multinational companies, including Samsung and Electrolux. In 2005, he left his corporate career to channel his engineering-grade analytical background into student instruction.
          </p>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Today, the center has grown to guide approximately 150 students annually, helping them clear board obstacles and enter leading engineering colleges.
          </p>
        </div>

        <!-- Right Column: School Reach & Alumni Results -->
        <div class="space-y-6">
          <span class="text-xs font-bold uppercase tracking-widest text-tan-dark">Our Legacy</span>
          <h2 class="text-3xl font-bold text-oxford">Premier School & Career Placements</h2>
          
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            We are proud to provide guidance to students from Kolkata's most prestigious schools, including:
          </p>
          
          <div class="grid grid-cols-2 gap-2 text-xs font-semibold text-oxford-dark bg-tan/5 p-4 rounded-xl border border-tan/10">
            <div>• St. Xavier's</div>
            <div>• Birla High</div>
            <div>• M. P. Birla</div>
            <div>• Mahadevi Birla</div>
            <div>• Ashok Hall</div>
            <div>• D.A.V. Public</div>
            <div>• Kendriya Vidyalaya</div>
            <div>• St. Thomas</div>
            <div>• Vivekananda Mission</div>
            <div>• National Gems</div>
          </div>
          
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            Our alumni are currently studying in premier IITs and leading engineering institutions across West Bengal. Many are working in multinational corporations like Cognizant, Tech Mahindra, and Wipro.
          </p>
        </div>
      </div>
    </div>

    <!-- Divider Line -->
    <hr class="border-tan/30 my-20" />

    <!-- Section: Core Pedagogy Values -->
    <div class="my-24">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-tan-dark">Our Values</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-oxford mt-2">
          The Advantage Educational Standard
        </h2>
        <p class="text-slate-600 mt-4 leading-relaxed">
          We combine physical classrooms, structured concept mastery, and strict board evaluation templates to maximize student scores.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {
          values.map((val) => (
            <div class="bg-white p-6 sm:p-8 rounded-2xl border border-tan/25 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col items-start">
              <div class="p-3 bg-tan/10 rounded-xl text-oxford mb-6" set:html={val.icon} />
              <h3 class="text-lg font-bold text-oxford mb-2">{val.title}</h3>
              <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{val.description}</p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Divider Line -->
    <hr class="border-tan/30 my-20" />

    <!-- Section: Faculty/Team Profile Cards -->
    <div class="my-24">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-tan-dark">Our Mentors</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-oxford mt-2">
          Meet Our Expert Faculty
        </h2>
        <p class="text-slate-600 mt-4 leading-relaxed">
          Highly qualified and permanent educators committed to personalized academic mentorship.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        {
          publishedTeamMembers.map((teamMemberEntry: any) => (
            <div class="group bg-white rounded-2xl border border-tan/30 shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 flex flex-col overflow-hidden">
              <div class="aspect-square w-full overflow-hidden bg-tan/10 relative shrink-0">
                <Picture
                  src={teamMemberEntry.data.avatar.src}
                  alt={teamMemberEntry.data.avatar.alt}
                  sizes="(max-width: 800px) 100vw, 300px"
                  width={300}
                  height={300}
                  class="w-full h-full object-cover object-center transition duration-500 group-hover:scale-105"
                />
              </div>

              <div class="p-6 text-center flex-grow flex flex-col justify-center">
                <h3 class="text-xl font-bold text-oxford group-hover:text-tan-dark transition duration-300">
                  {teamMemberEntry.data.name}
                </h3>
                <p class="text-xs font-semibold text-slate-500 mt-1 uppercase tracking-wider">
                  {teamMemberEntry.data.title}
                </p>
                <p class="text-xs text-slate-400 font-bold mt-2 bg-tan/5 py-1 px-3.5 rounded-full border border-tan/10 inline-block self-center">
                  {teamMemberEntry.data.ed}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Section: CTA Banner -->
    <div class="relative overflow-hidden bg-gradient-to-br from-oxford-dark via-oxford to-oxford-light text-white rounded-3xl p-10 md:p-16 shadow-2xl mt-16 mb-24 border border-oxford-light/50 max-w-4xl mx-auto">
      <div class="absolute inset-0 opacity-15">
        <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
          <circle cx="20" cy="20" r="30" fill="white" class="animate-pulse"></circle>
          <circle cx="85" cy="75" r="25" fill="white" class="animate-pulse"></circle>
        </svg>
      </div>

      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="text-center md:text-left max-w-lg">
          <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-tight">Enroll Your Child Today</h3>
          <p class="text-white/80 mt-2 text-sm sm:text-base">
            Secure top grades in school and college admissions. Schedule a personal consultation with our coordinator.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto shrink-0 justify-center">
          <a
            href="/#enrollment"
            class="bg-tan hover:bg-tan-dark text-oxford-dark font-bold text-center px-8 py-3.5 rounded-xl transition duration-300 shadow-md hover:shadow-lg text-sm w-full sm:w-auto"
          >
            Apply Now
          </a>
          <a
            href="tel:+919433427259"
            class="border border-white/30 hover:border-white text-white font-semibold text-center px-8 py-3.5 rounded-xl transition duration-300 text-sm w-full sm:w-auto hover:bg-white/5"
          >
            Call Admissions
          </a>
        </div>
      </div>
    </div>
  </Container>
</Layout>