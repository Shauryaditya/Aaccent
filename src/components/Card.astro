---
import { Image } from 'astro:assets';
export interface Props {
  title: string;
  text: string;
  imagePath: string;
  width?: number;
  height?: number;
  enrollLink?: string;
  priceLabel?: string;
}

const { 
  title,
  text,
  imagePath,
  width = 400,
  height = 300,
  enrollLink = "#enrollment",
  priceLabel
} = Astro.props;
---

<div class="course-card">
  <div class="image-container">
    <Image 
      height={height} 
      width={width} 
      src={imagePath} 
      alt={title}
      class="course-image"
    />
  </div>
  
  <div class="card-content">
    <h2 class="course-title">{title}</h2>
    
    {priceLabel && (
      <div class="self-center bg-tan/10 text-oxford-dark text-xs font-semibold py-1 px-3 rounded-full border border-tan/30 text-center mb-3">
        {priceLabel}
      </div>
    )}
    
    <div class="course-text">
      {text}
    </div>
    
    <div class="button-group">
      <a href={enrollLink} class="btn btn-enroll">Enroll Now</a>
    </div>
  </div>
</div>

<style>
  .course-card {
    background: #ffffff;
    border: 1px solid rgba(210, 180, 140, 0.25);
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(210, 180, 140, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    max-width: 380px;
    width: 100%;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .course-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(210, 180, 140, 0.15);
    border-color: rgba(210, 180, 140, 0.6);
  }

  .image-container {
    width: 100%;
    height: 280px;
    overflow: hidden;
    background: #f5ece0;
    flex-shrink: 0;
  }

  .course-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .course-card:hover .course-image {
    transform: scale(1.05);
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .course-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #001530;
    margin-bottom: 1rem;
    text-align: center;
    transition: color 0.3s ease;
  }

  .course-card:hover .course-title {
    color: #bfa27a;
  }

  .course-text {
    font-size: 0.875rem;
    color: rgba(0, 33, 71, 0.75);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .button-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.75rem 2rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    font-size: 0.875rem;
    text-align: center;
    width: 100%;
  }

  .btn-enroll {
    background: #002147;
    color: #ffffff;
    border: 2px solid #002147;
  }

  .btn-enroll:hover {
    background: #0a2e5c;
    border-color: #0a2e5c;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 33, 71, 0.2);
  }

  @media (max-width: 480px) {
    .course-title {
      font-size: 1rem;
    }

    .btn {
      font-size: 0.8rem;
      padding: 0.65rem 1.5rem;
    }

    .image-container {
      height: 240px;
    }
  }
</style>