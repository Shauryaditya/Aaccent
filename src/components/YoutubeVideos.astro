---
// src/components/YoutubeVideos.astro
const videos = [
  { id: "VOta3CQP0ZI", title: "Advantage Academic Center Video 1" },
  { id: "9Jm1lryP6DM", title: "Advantage Academic Center Video 2" },
  { id: "NM1U9RS0A18", title: "Advantage Academic Center Video 3" },
];
---

<section class="py-12 px-4 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto relative z-10">
    
    <!-- Header -->
    <div class="text-center mb-12 max-w-3xl mx-auto youtube-header">
      <h2 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 leading-tight">
        Learn From Our Experts
      </h2>
      <p class="text-lg text-stone-600 leading-relaxed">
        Watch our latest tutorials and educational content directly on our channel.
      </p>
    </div>

    <!-- Video Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {videos.map((video, index) => (
        <div 
          class="youtube-card bg-stone-50 p-4 rounded-2xl shadow-lg border-2 border-stone-100 hover:border-stone-300 hover:-translate-y-2 hover:shadow-2xl transition-all duration-300"
          data-video-index={index}
        >
          <iframe 
            class="w-full aspect-video rounded-xl" 
            src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0`} 
            title={video.title} 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            allowfullscreen>
          </iframe>
        </div>
      ))}
    </div>

  </div>
</section>

